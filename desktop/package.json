{
  "name": "republica-mascotas-vetcarepro",
  "productName": "República Mascotas",
  "version": "2.0.0",
  "description": "VetCare Pro 2.0 — Gestión veterinaria (offline)",
  "author": "República Mascotas",
  "license": "UNLICENSED",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "sharp": "^0.35.5"
  },
  "build": {
    "appId": "com.republicamascotas.vetcarepro",
    "productName": "Republica Mascotas",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "web/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "RepublicaMascotas-VetCarePro-2.0.0.exe"
    },
    "compression": "maximum"
  }
}
